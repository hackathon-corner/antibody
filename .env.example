# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# Never paste these values in chat, commits, or screenshots.

# --- ClickHouse (C2/C3, evidence store) ---
# App user: write access, used by src/adapters/clickhouse_events.py
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=antibody

# Read-only user for the evidence API / Akash SDL rendering (scripts/render_evidence_sdl.py)
# Must be a different user than CLICKHOUSE_USER -- the script rejects a reused admin/app user.
CLICKHOUSE_READER_USER=
CLICKHOUSE_READER_PASSWORD=

# --- Senso (A7, repair guidance retrieval) ---
# src/adapters/senso.py -- auth via API key, not an interactive `senso login` session,
# so the adapter works wherever the host runner actually executes.
SENSO_API_KEY=

# --- Guild AI (A1/A3, repair agent runtime) ---
# CLI auth is interactive (`guild auth login`); GUILD_API_KEY is only needed for
# non-interactive/CI use per the Guild CLI docs (format: <id>:<secret>).
# GUILD_API_KEY=

# --- Server (host API CORS) ---
# ANTIBODY_CORS_ORIGINS=http://localhost:5173
# ANTIBODY_WEB_DIST=
